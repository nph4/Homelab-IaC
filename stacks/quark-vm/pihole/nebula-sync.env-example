# Copy to /home/quark/containers/pihole/nebula-sync.env on quark-vm (mode 600).
# PRIMARY: the Pi. Use an app password (Pi-hole web UI > Settings > Web interface / API > Configure app password).
# Since FTL v6.8 the Pi also needs webserver.api.app_sudo = true, or every sync fails with 403.
PRIMARY=https://192.168.88.34:8443|CHANGEME
# REPLICAS: this stack's own Pi-hole, by service name, with the password from .env
REPLICAS=http://pihole|CHANGEME
# Uptime Kuma push monitor "nebula-sync" (heartbeat 3.5h): up on success, down on failure
WEBHOOK_SYNC_SUCCESS_URL=https://kuma.local.nelsonhickman.com/api/push/CHANGEME?status=up&msg=sync%20ok
WEBHOOK_SYNC_SUCCESS_METHOD=GET
WEBHOOK_SYNC_FAILURE_URL=https://kuma.local.nelsonhickman.com/api/push/CHANGEME?status=down&msg=sync%20failed
WEBHOOK_SYNC_FAILURE_METHOD=GET
