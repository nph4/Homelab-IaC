# Copy to /home/quark/containers/pihole/nebula-sync.env on quark-vm (mode 600).
# PRIMARY: the Pi. Use an app password (Pi-hole web UI > Settings > Web interface / API > Configure app password).
PRIMARY=https://192.168.88.34:8443|CHANGEME
# REPLICAS: this stack's own Pi-hole, by service name, with the password from .env
REPLICAS=http://pihole|CHANGEME
