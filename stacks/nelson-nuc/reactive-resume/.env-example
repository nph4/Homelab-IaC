# Copy to /home/nelson/containers/reactive-resume/.env on nelson-nuc.
# Shared by all reactive-resume services. env_file can't do variable
# interpolation, so composed/reused values are written out literally
# under each key below — set POSTGRES_PASSWORD, MINIO_ROOT_USER, and
# MINIO_ROOT_PASSWORD once, then repeat those exact values into
# DATABASE_URL, STORAGE_ACCESS_KEY, and STORAGE_SECRET_KEY.

# Database (postgres)
POSTGRES_PASSWORD=CHANGEME

# MinIO / storage (minio)
MINIO_ROOT_USER=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME

# App (app) — must match the values above exactly
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres
STORAGE_ACCESS_KEY=CHANGEME
STORAGE_SECRET_KEY=CHANGEME

# App auth secret (generate a strong random string)
AUTH_SECRET=CHANGEME

# Email
MAIL_FROM=resume@yourdomain.com
# SMTP_URL=smtp://user:pass@smtp.example.com:587

# Optional:
# DISABLE_SIGNUPS=true
# DISABLE_EMAIL_AUTH=true
