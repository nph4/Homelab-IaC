# Copy to /home/nelson/containers/adventurelog/.env on nelson-nuc.
# Shared by both the adventurelog and adventurelog-db services.

# Required — password for the "adventure" Postgres/PostGIS role.
POSTGRES_PASSWORD=CHANGEME

# Strongly recommended — if left unset, the image's own /aio/env-setup.sh
# silently defaults these to username=admin password=admin
# email=admin@example.com and creates that superuser on first boot. Not
# safe on a publicly exposed instance. Only takes effect the first time
# the DB is empty (create_superuser_if_needed no-ops once the account
# exists), so set these before the very first deploy.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=CHANGEME
DJANGO_ADMIN_EMAIL=CHANGEME

# Optional — uncomment and set as needed. See:
# https://adventurelog.app/docs/configuration/environment_variables.html

# Registration (open by default — uncomment to lock down after creating your account)
#DISABLE_REGISTRATION=true
#DISABLE_REGISTRATION_MESSAGE=Registration is currently closed.

# Google Maps (place autocomplete, geocoding)
#GOOGLE_MAPS_API_KEY=

# Outbound email (invites, password resets) — EMAIL_BACKEND defaults to console (logs only)
#EMAIL_BACKEND=email
#EMAIL_HOST=smtp.mailgun.org
#EMAIL_PORT=587
#EMAIL_USE_TLS=true
#EMAIL_HOST_USER=noreply@relay.nelsonhickman.com
#EMAIL_HOST_PASSWORD=
#DEFAULT_FROM_EMAIL=adventurelog@relay.nelsonhickman.com

# Strava import integration
#STRAVA_CLIENT_ID=
#STRAVA_CLIENT_SECRET=

# S3-compatible object storage for media (instead of the local volume)
#MEDIA_STORAGE=s3
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_STORAGE_BUCKET_NAME=
#AWS_S3_ENDPOINT_URL=
#AWS_S3_REGION_NAME=
