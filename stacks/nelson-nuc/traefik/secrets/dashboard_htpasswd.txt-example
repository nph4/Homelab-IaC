# Place the real file at /home/nelson/containers/traefik/dashboard_htpasswd.txt
# Format: user:bcrypt-hash (standard htpasswd format, no Compose $$ escaping needed
# since this is read as a plain file by Traefik's basicAuth.usersFile, not
# interpolated through Compose ${VAR} substitution).
#
# Generate with:
#   htpasswd -nB admin
admin:$2y$05$REPLACE_ME
