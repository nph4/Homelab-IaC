# Lives at /home/nelson/containers/bookstack/.env on nelson-nuc (mode 600). Shared by both services.
# Laravel app key: base64: followed by 32 random bytes, e.g. "base64:$(openssl rand -base64 32)"
APP_KEY=base64:CHANGEME
# DB_PASSWORD (BookStack) and MARIADB_PASSWORD (MariaDB init) must be the same value
DB_PASSWORD=CHANGEME
MARIADB_PASSWORD=CHANGEME
MARIADB_ROOT_PASSWORD=CHANGEME
